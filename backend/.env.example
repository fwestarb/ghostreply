# ============================================================
# Servidor
# ============================================================
PORT=4000
NODE_ENV=development

# ============================================================
# Supabase
# Este backend usa o Supabase como banco Postgres. A extensão não se
# conecta diretamente: login e dados passam pela API deste servidor.
# Use a secret key nova (ou, em projeto legado, a service_role). Essas
# chaves dão acesso de servidor; nunca as copie para a extensão.
# ============================================================
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa para projetos com chave legada:
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# JWT (access token)
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Refresh token: não é um JWT, é um token opaco (uuid) guardado
# com hash no banco, para poder ser revogado a qualquer momento.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ============================================================
# CORS
# Origens autorizadas a chamar esta API. Para uma extensão Chrome,
# a origem é "chrome-extension://<ID_DA_EXTENSAO>".
# ============================================================
CORS_ALLOWED_ORIGINS=chrome-extension://bahdachhgpghminepmemhkddafffggko

# ============================================================
# E-mail (recuperação de senha) — SMTP via nodemailer
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GhostReply <no-reply@ghostreply.app>"

# URL pública onde este backend está hospedado, usada para montar o
# link de redefinição de senha enviado por e-mail.
APP_BASE_URL=http://localhost:4000

# ============================================================
# Login com Google
# A extensão obtém o id_token via chrome.identity; o backend só
# precisa verificar a assinatura e o "aud" (client id) desse token.
# Não é necessário client secret nem redirect URI aqui.
# ============================================================
GOOGLE_CLIENT_ID=

# ============================================================
# OpenRouter (geração de respostas, tradução e revisão)
#
# IMPORTANTE: esta chave fica SÓ aqui, no backend. Ela nunca deve ser
# copiada para dentro da extensão — o arquivo api.js roda no navegador
# e qualquer pessoa com o DevTools aberto conseguiria lê-la.
#
# Use openrouter/free ou um identificador terminado em :free.
# O backend bloqueia modelos pagos. Cotas e disponibilidade variam.
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# ============================================================
# Rate limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Rotas de IA: janela curta, teto por minuto. Protege contra um loop
# acidental na extensão queimar créditos da OpenRouter.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

