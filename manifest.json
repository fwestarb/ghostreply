{
  "manifest_version": 3,
  "name": "GhostReply",
  "version": "2.0.3",
  "description": "Assistente de atendimento com IA para WhatsApp Web: sugere respostas baseadas na base de conhecimento da empresa.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "messaging.js",
        "api.js",
        "auth-client.js",
        "knowledge-client.js",
        "spring.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "110"
}
